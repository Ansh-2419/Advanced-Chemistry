{
  "namespace": "relic_synthesizer",

  "relic_top": {
    "type": "collection_panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "size": [162, 72],
    "offset": [-10, -40],
    "controls": [
      {
        "machine_name@uc.machine_name": {
          "$offset": [10, 0]
        }
      },
      {
        "panel@uc.machine_side_panel": {}
      },
      {
        "item_label@uc.text_label": {
          "collection_index": 1,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [74, 140],
          "$text_scale": 0.55,
          "offset": [-78, 2]
        }
      },
      {
        "energy_bar@uc.energy_bar": {
          "$has_bg": false,
          "offset": [-72, 0]
        }
      },
      {
        "input_slot@uc.input_slot": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "collection_index": 3,
          "size": [24, 24],
          "offset": [-26, 22],
          "layer": 1
        }
      },
      {
        "progress_arrow@uc.progress_display": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "collection_index": 2,
          "offset": [10, 28]
        }
      },
      {
        "output_grid@uc.slot_grid_3x3": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [60, 12],
          "$slot_outline_texture": "textures/ui/slots/output_slot",
          "$collection_index_1": 4,
          "$collection_index_2": 5,
          "$collection_index_3": 6,
          "$collection_index_4": 7,
          "$collection_index_5": 8,
          "$collection_index_6": 9,
          "$collection_index_7": 10,
          "$collection_index_8": 11,
          "$collection_index_9": 12
        }
      },
      {
        "upgrades_tab@uc.upgrades_tab": {
          "$upgrade_index_1": 13,
          "$upgrade_index_2": 14
        }
      },
      {
        "io_tab@uc.io_tab": {
          "$io_items_modes_description": "ui.aoc:io.relic_synthesizer.items",
          "$has_item_io": true,
          "$has_fluid_io": false,
          "$io_items_default": true,
          "$io_top_texture":    "textures/blocks/common",
          "$io_left_texture":   "textures/blocks/common",
          "$io_front_texture":  "textures/blocks/common",
          "$io_right_texture":  "textures/blocks/common",
          "$io_bottom_texture": "textures/blocks/common",
          "$io_back_texture":   "textures/blocks/common",
          "$io_item_top_index":    15,
          "$io_item_left_index":   16,
          "$io_item_front_index":  17,
          "$io_item_right_index":  18,
          "$io_item_bottom_index": 19,
          "$io_item_back_index":   20
        }
      },
      {
        "info_tab@uc.info_tab": {
          "$info_description": "ui.aoc:info.relic_synthesizer"
        }
      }
    ]
  },

  "utility_panel": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      { "flying_item_renderer@common.flying_item_renderer": { "layer": 14 } },
      { "selected_item_details_factory@common.selected_item_details_factory": {} },
      { "item_lock_notification_factory@common.item_lock_notification_factory": {} },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "controls": [
            { "common_panel@common.common_panel": {} },
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  { "relic_top@relic_synthesizer.relic_top": {} },
                  { "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {} },
                  { "hotbar_grid@common.hotbar_grid_template": {} },
                  { "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {} }
                ]
              }
            },
            { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
            { "gamepad_cursor@common.gamepad_cursor_button": {} }
          ]
        }
      }
    ]
  }
}
