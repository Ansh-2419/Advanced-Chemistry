{
    "namespace": "how_to_play",

    "how_to_play_selector_stack_panel/how_to_play_selector_pane": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_front",
                "value": [
                    {
                        "padding_aoc_00": {
                            "type": "panel",
                            "size": [ 0, 6 ]
                        }
                    },
                    {
                        "aoc_category@how_to_play_common.topic_category": {
                            "$category": "age_of_chemical"
                        }
                    },
                    {
                        "aoc:introduction_button@how_to_play.aoc:introduction_button": {
                            "$toggle_group_forced_index": 401
                        }
                    },
                    {
                        "aoc:machines_button@how_to_play.aoc:machines_button": {
                            "$toggle_group_forced_index": 402
                        }
                    },
                    {
                        "aoc:items_button@how_to_play.aoc:items_button": {
                            "$toggle_group_forced_index": 403
                        }
                    },
                    {
                        "aoc:multiblock_button@how_to_play.aoc:multiblock_button": {
                            "$toggle_group_forced_index": 404
                        }
                    }
                ]
            }
        ]
    },

