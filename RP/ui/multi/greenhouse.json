          "size": [
            74,
            140
          ],
          "$text_scale": 0.55,
          "offset": [
            -78,
            2
          ]
        }
      },
      {
        "energy_bar@uc.energy_bar": {
          "$has_bg": false,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": "$energy_bar_offset",
          "$bar_bg_texture": "$energy_bar_bg_texture"
        }
      },
      {
        "fluid_bar_fertilizer@uc.fluid_bar": {
          "$collection_index": 3,
