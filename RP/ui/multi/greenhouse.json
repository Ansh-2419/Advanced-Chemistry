          "layer": 1
        }
      },
      {
        "seed_slot_2@uc.input_slot": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "collection_index": 6,
          "offset": [
            -6,
            28
          ],
          "layer": 1
        }
      },
      {
        "seed_slot_3@uc.input_slot": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "collection_index": 7,
          "offset": [
            -26,
            48
          ],
          "layer": 1
        }
      },
      {
        "seed_slot_4@uc.input_slot": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "collection_index": 8,
          "offset": [
            -6,
            48
          ],
          "layer": 1
        }
      },
      {
        "soil_slot@greenhouse.greenhouse_soil_slot": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "collection_index": 9,
          "offset": [
            -8,
            74
          ],
          "layer": 1
        }
      },
      {
        "progress_arrow@uc.progress_display": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "collection_index": 2,
          "offset": [
            20,
            42
          ]
        }
      },
      {
