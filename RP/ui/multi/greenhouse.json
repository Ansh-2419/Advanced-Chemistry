{
  "namespace": "greenhouse",
  "greenhouse_soil_slot": {
    "type": "input_panel",
    "$slot_background_texture|default": "textures/ui/slots/input_1_slot",
    "size": [
      22,
      22
    ],
    "controls": [
      {
        "item@common.container_item": {
          "$cell_image_size": [
            22,
            22
          ],
          "layer": 1
        }
      },
      {
        "slot_background": {
          "type": "image",
          "texture": "$slot_background_texture",
          "size": [
            22,
            22
          ],
          "layer": 4
        }
      }
    ]
  },
  "greenhouse_top": {
    "type": "collection_panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "size": [
      200,
      110
    ],
    "offset": [
      -10,
      -58
    ],
    "$energy_bar_offset|default": [
      97,
      64
    ],
    "$energy_bar_anchor|default": "top_left",
    "$energy_bar_bg_texture|default": "textures/ui/toggle_button/left_bg",
    "$right_machine_tabs_name|default": "right_machine_tabs",
    "$info_toggle_control_name|default": "info_toggle_button",
    "controls": [
      {
        "machine_name@uc.machine_name": {
          "$offset": [
            10,
            0
          ]
        }
      },
      {
        "panel@uc.machine_side_panel": {}
      },
      {
        "item_label@uc.text_label": {
