          "layer": 1
        }
      },
      {
        "slot_background": {
          "type": "image",
          "texture": "$slot_background_texture",
          "size": [18, 18],
          "layer": 4
        }
      }
    ]
  },
  "input_2": {
    "type": "input_panel",
