{
    "format_version": "1.21.100",
    "minecraft:block": {
        "description": {
            "identifier": "utilitycraft:greenhouse_controller",
            "menu_category": {
                "category": "equipment"
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": ["minecraft:cardinal_direction"],
                    "y_rotation_offset": 180
                }
            }
        },
        "components": {
            "utilitycraft:greenhouse_controller": {},
            "minecraft:geometry": "minecraft:geometry.full_block",
            "minecraft:material_instances": {
                "*":     { "texture": "industrial_caseing",    "render_method": "opaque" },
                "north": { "texture": "greenhouse_controller", "render_method": "opaque" },
                "south": { "texture": "industrial_caseing",    "render_method": "opaque" },
                "east":  { "texture": "industrial_caseing",    "render_method": "opaque" },
                "west":  { "texture": "industrial_caseing",    "render_method": "opaque" },
                "up":    { "texture": "industrial_caseing",    "render_method": "opaque" },
                "down":  { "texture": "industrial_caseing",    "render_method": "opaque" }
            },
            "minecraft:tick": { "interval_range": [4, 4] },
            "minecraft:destructible_by_mining": { "seconds_to_destroy": 3 },
            "minecraft:destructible_by_explosion": false,
            "tag:dorios:controller": {}
        },
        "permutations": [
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": { "minecraft:transformation": { "rotation": [0, 0, 0] } }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
                "components": { "minecraft:transformation": { "rotation": [0, 180, 0] } }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": { "minecraft:transformation": { "rotation": [0, -90, 0] } }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } }
            }
        ]
    }
}
