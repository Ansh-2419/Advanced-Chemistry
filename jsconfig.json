{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "DoriosCore": ["types/DoriosCore/index.d.ts"],
      "DoriosCore/index.js": ["types/DoriosCore/index.d.ts"],
      "DoriosLib": ["types/DoriosLib/index.d.ts"],
      "DoriosLib/index.js": ["types/DoriosLib/index.d.ts"],
      "DoriosLib/*": ["types/DoriosLib/index.d.ts"],
      "config/*": ["BP/scripts/config/*"],
      "machinery/*": ["BP/scripts/machinery/*"]
    },
    "skipLibCheck": true
  },
  "include": [
    "BP/scripts/block/**/*.js",
    "BP/scripts/config/**/*.js",
    "BP/scripts/machinery/**/*.js",
    "BP/scripts/cleanupUiItems.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".regolith",
    "build",
    "builds",
    "dist",
    "data",
    "BP/scripts/DoriosCore",
    "BP/scripts/DoriosLib"
  ]
}
